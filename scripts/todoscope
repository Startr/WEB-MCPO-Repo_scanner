#!/bin/bash
set -euo pipefail

VERSION="1.1.0"

IMAGE="ghcr.io/startr/todoscope:latest"
CONTAINER="todoscope"
VOLUME="todoscope-data"
DATA_MOUNT="/app/scanner/repositories"
DEFAULT_PORT=5000

# ---------------------------------------------------------------------------
# Sage project registry (~/.sage-is/)
# Remembers where you cloned things so you never lose your code.
# ---------------------------------------------------------------------------
SAGE_CONFIG_DIR="${HOME}/.sage-is"
SAGE_PROJECTS="${SAGE_CONFIG_DIR}/projects"

# The upstream remote URL pattern (matches any protocol/suffix).
TODOSCOPE_REMOTE="Startr/TodoScope"

# Read saved clone path for a project. Prints nothing if unset.
sage_project_dir() {
  [[ -f "$SAGE_PROJECTS" ]] && sed -n "s/^${1}=//p" "$SAGE_PROJECTS"
}

# Save (or update) the clone path for a project.
sage_set_project_dir() {
  local project="$1" dir="$2"
  mkdir -p "$SAGE_CONFIG_DIR"
  # Remove existing entry, then append. sed -i.bak for macOS compat.
  if [[ -f "$SAGE_PROJECTS" ]]; then
    sed -i.bak "/^${project}=/d" "$SAGE_PROJECTS" && rm -f "${SAGE_PROJECTS}.bak"
  fi
  echo "${project}=${dir}" >> "$SAGE_PROJECTS"
}

# Check if a directory is a clone of a given repo (by git remote, not folder name).
is_repo_for() {
  local dir="$1" pattern="$2"
  [[ -d "$dir/.git" ]] && git -C "$dir" remote -v 2>/dev/null | grep -qi "$pattern"
}

# Find a matching repo nearby: check cwd (walk up to git root), then scan subdirs.
# Detects by content (git remote), not directory name — works with any folder name.
find_repo_nearby() {
  local pattern="$1"

  # Are we already inside a matching repo?
  local git_root
  git_root="$(git rev-parse --show-toplevel 2>/dev/null)" || true
  if [[ -n "$git_root" ]] && is_repo_for "$git_root" "$pattern"; then
    echo "$git_root"; return 0
  fi

  # Scan immediate subdirectories (one level) for any matching clone.
  local subdir
  for subdir in ./*/; do
    [[ -d "$subdir/.git" ]] || continue
    if is_repo_for "$subdir" "$pattern"; then
      (cd "$subdir" && pwd); return 0
    fi
  done

  return 1
}

# Check if a path is ephemeral (won't survive reboot).
is_ephemeral_path() {
  case "$1" in
    /tmp/*|/private/tmp/*|/var/folders/*) return 0 ;;
    *) return 1 ;;
  esac
}

# ---------------------------------------------------------------------------
# Find a free port starting from the given one.
# ---------------------------------------------------------------------------
find_free_port() {
  local port="$1"
  local max_tries=20
  local i=0
  while (( i < max_tries )); do
    if ! lsof -iTCP:"$port" -sTCP:LISTEN &>/dev/null; then
      echo "$port"
      return 0
    fi
    echo "Port $port is taken, trying $((port + 1))..." >&2
    port=$((port + 1))
    i=$((i + 1))
  done
  echo "Error: Could not find a free port after $max_tries attempts." >&2
  return 1
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
  cat <<EOF
Usage: todoscope <command> [options]

Commands:
  start [--port PORT]   Pull image and start TodoScope (default port: $DEFAULT_PORT)
  stop                  Stop the running container
  update [--port PORT]  Pull latest image and restart
  dev [--port PORT] [--dir DIR] [--where]  Clone and run in dev mode with hot reload
  logs                  Tail container logs
  open                  Open the UI in your default browser
  status                Show container status
  version               Show CLI version
  tunnel                Start a cloudflared quick tunnel to expose the container
  tailscale             Start a Tailscale funnel to expose the container
  nuke                  Remove everything TodoScope — clean slate

EOF
}

# ---------------------------------------------------------------------------
# Ensure Docker is reachable. Auto-starts or installs a provider if needed.
# ---------------------------------------------------------------------------
ensure_docker() {
  if docker info &>/dev/null; then
    return 0
  fi

  case "$(uname)" in
    Darwin)
      if [ -d "/Applications/Docker.app" ]; then
        echo "Starting Docker Desktop..."
        open -a Docker
      elif [ -d "/Applications/OrbStack.app" ]; then
        echo "Starting OrbStack..."
        open -a OrbStack
      elif command -v colima &>/dev/null; then
        echo "Starting Colima..."
        colima start
      elif command -v brew &>/dev/null; then
        echo "No Docker provider found. Installing Docker Desktop via Homebrew..."
        brew install --cask docker
        echo "Starting Docker Desktop..."
        open -a Docker
      else
        echo "Error: No Docker provider found and Homebrew is not available."
        echo "  Install Docker Desktop: https://docs.docker.com/get-docker/"
        exit 1
      fi

      echo "Waiting for Docker daemon..."
      for i in $(seq 1 30); do
        if docker info &>/dev/null; then
          echo "Docker is ready."
          return 0
        fi
        sleep 1
      done

      echo "Error: Docker daemon did not start within 30 seconds."
      echo "  Try starting it manually and run 'todoscope start' again."
      exit 1
      ;;

    Linux)
      if ! command -v docker &>/dev/null && command -v brew &>/dev/null; then
        echo "Docker not found. Installing via Homebrew..."
        brew install docker
        echo "Note: You also need Docker Engine running."
        echo "  See: https://docs.docker.com/engine/install/"
        exit 1
      fi
      echo "Error: Docker daemon is not running."
      echo "  Start it with: sudo systemctl start docker"
      echo "  Enable on boot: sudo systemctl enable docker"
      exit 1
      ;;

    *)
      echo "Error: Cannot connect to Docker."
      exit 1
      ;;
  esac
}

# ---------------------------------------------------------------------------
# Detect the host port the container is bound to.
# ---------------------------------------------------------------------------
get_container_port() {
  local port
  port=$(docker port "$CONTAINER" "$DEFAULT_PORT" 2>/dev/null | head -1 | cut -d: -f2)
  if [[ -z "$port" ]]; then
    echo "Error: Container '$CONTAINER' is not running." >&2
    echo "  Start it first with: todoscope start" >&2
    return 1
  fi
  echo "$port"
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_version() {
  echo "todoscope $VERSION"
}

cmd_start() {
  local port=$DEFAULT_PORT
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done

  ensure_docker

  # Auto-find free port if the requested one is taken
  port=$(find_free_port "$port")

  echo "Pulling latest image..."
  docker pull "$IMAGE"

  # Stop existing container if running
  docker rm -f "$CONTAINER" 2>/dev/null || true

  echo "Starting TodoScope on port $port..."
  docker run -d \
    -p "$port:$DEFAULT_PORT" \
    -v "$VOLUME:$DATA_MOUNT" \
    --name "$CONTAINER" \
    "$IMAGE"

  echo ""
  echo "TodoScope is running at http://localhost:$port"
  echo "Run 'todoscope open' to open in your browser."
}

cmd_stop() {
  echo "Stopping TodoScope..."
  docker stop "$CONTAINER" 2>/dev/null || true
  docker rm "$CONTAINER" 2>/dev/null || true
  echo "Stopped."
}

cmd_update() {
  local port_args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port_args+=(--port "$2"); shift 2 ;;
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done

  echo "Pulling latest image..."
  docker pull "$IMAGE"
  cmd_stop
  cmd_start "${port_args[@]}"
}

cmd_dev() {
  local port=$DEFAULT_PORT
  local explicit_dir=""
  local repo_dir=""
  local saved
  saved="$(sage_project_dir todoscope)" || true
  local needs_clone=false

  # --- Parse flags ---
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port)  port="$2"; shift 2 ;;
      --dir)   explicit_dir="$2"; shift 2 ;;
      --where)
        # Quick lookup: where's my code?
        if [[ -n "$saved" ]]; then
          echo "$saved"
        else
          echo "No saved location yet. Run 'todoscope dev' to set one up."
        fi
        return 0
        ;;
      *) echo "Unknown option: $1"; usage; exit 1 ;;
    esac
  done

  # --- Step 1: Explicit --dir? Trust the user. ---
  if [[ -n "$explicit_dir" ]]; then
    repo_dir="$explicit_dir"
    if [[ -n "$saved" && "$saved" != "$repo_dir" ]]; then
      echo "Note: switching from $saved (previously saved) to $repo_dir."
    fi

  # --- Step 2: TODOSCOPE_DEV_DIR env var? Backwards compat. ---
  elif [[ -n "${TODOSCOPE_DEV_DIR:-}" ]]; then
    repo_dir="$TODOSCOPE_DEV_DIR"
    if [[ -n "$saved" && "$saved" != "$repo_dir" ]]; then
      echo "Note: TODOSCOPE_DEV_DIR is set — switching from $saved to $repo_dir."
    fi

  # --- Step 3: Are we inside (or next to) a TodoScope repo right now? ---
  elif repo_dir="$(find_repo_nearby "$TODOSCOPE_REMOTE")"; then
    if [[ -n "$saved" && "$saved" != "$repo_dir" ]]; then
      echo "Found TodoScope source here ($repo_dir)."
      echo "  Note: previously saved as $saved — updating."
    elif [[ -z "$saved" ]]; then
      echo "Found TodoScope source here ($repo_dir). Saving for next time."
    else
      echo "Using TodoScope source at $repo_dir"
    fi

  # --- Step 4: Do we have a saved path from last time? ---
  elif [[ -n "$saved" ]]; then
    if [[ -d "$saved" ]]; then
      echo "Using your TodoScope source at $saved (saved from last time)."
      repo_dir="$saved"
    else
      # The directory is gone — don't silently forget.
      echo "Heads up — your TodoScope source was at $saved, but that directory is gone."
      echo "  (If you moved it, you can point us there with: todoscope dev --dir /new/path)"
      echo ""
      repo_dir="${HOME}/src/todoscope"
      needs_clone=true
    fi

  # --- Step 5: First time, nothing found. Clone fresh. ---
  else
    repo_dir="${HOME}/src/todoscope"
    needs_clone=true
  fi

  # --- Clone if needed ---
  if [[ "$needs_clone" == true ]] || [[ ! -d "$repo_dir" ]]; then
    echo "Cloning TodoScope to $repo_dir..."
    git clone "https://github.com/${TODOSCOPE_REMOTE}.git" "$repo_dir"
    echo "  (We'll remember this location for next time.)"
  fi

  # --- Step 6: Ephemeral path warning ---
  if is_ephemeral_path "$repo_dir"; then
    echo ""
    echo "  Warning: $repo_dir may not survive a reboot."
    echo "    Your code changes could be lost."
    echo "    For a permanent location: todoscope dev --dir ~/src/todoscope"
    echo ""
  fi

  # --- Save the resolved path for next time ---
  sage_set_project_dir todoscope "$repo_dir"

  # --- Auto-find free port ---
  port=$(find_free_port "$port")

  # --- Start dev container ---
  ensure_docker

  docker rm -f "$CONTAINER" 2>/dev/null || true

  echo "Pulling latest image..."
  docker pull "$IMAGE"

  echo "Starting in dev mode on port $port..."
  docker run -d \
    -p "$port:$DEFAULT_PORT" \
    -v "$VOLUME:$DATA_MOUNT" \
    -v "$repo_dir/scanner:/app/scanner" \
    -v "$repo_dir/app.py:/app/app.py" \
    -e FLASK_ENV=development \
    -e FLASK_DEBUG=1 \
    --name "$CONTAINER" \
    "$IMAGE"

  echo ""
  echo "Dev mode running. Source: $repo_dir"
  echo "App: http://localhost:$port"
  echo ""
  echo "Run 'todoscope logs' to see output."
  echo "Run 'todoscope open' to open in your browser."
}

cmd_logs() {
  docker logs -f "$CONTAINER"
}

cmd_open() {
  local port
  port=$(get_container_port) || exit 1
  local url="http://localhost:$port"
  case "$(uname)" in
    Darwin) open "$url" ;;
    *)      xdg-open "$url" 2>/dev/null || echo "Open $url in your browser." ;;
  esac
}

cmd_status() {
  docker inspect --format='Status: {{.State.Status}}' "$CONTAINER" 2>/dev/null || echo "Container is not running."
  local port
  port=$(docker port "$CONTAINER" "$DEFAULT_PORT" 2>/dev/null | head -1 | cut -d: -f2)
  if [[ -n "$port" ]]; then
    echo "URL: http://localhost:$port"
  fi
}

cmd_tunnel() {
  if ! command -v cloudflared &>/dev/null; then
    echo "Error: cloudflared is not installed."
    echo "  Install with: brew install cloudflared"
    exit 1
  fi

  local port
  port=$(get_container_port) || exit 1

  echo "Starting cloudflared quick tunnel to http://localhost:$port ..."
  echo "Press Ctrl+C to stop the tunnel (the container keeps running)."
  echo ""
  cloudflared tunnel --url "http://localhost:$port"
}

cmd_tailscale() {
  if ! command -v tailscale &>/dev/null; then
    echo "Error: tailscale is not installed."
    echo "  Install with: brew install tailscale"
    exit 1
  fi

  local port
  port=$(get_container_port) || exit 1

  echo "Starting Tailscale funnel on port $port ..."
  echo "Press Ctrl+C to stop the funnel (the container keeps running)."
  echo ""
  tailscale funnel "$port"
}

# Nuke from orbit — delegates to nuke-sage.
cmd_nuke() {
  local script_dir
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  if [[ -x "$script_dir/nuke-sage" ]]; then
    exec "$script_dir/nuke-sage" todoscope "$@"
  else
    echo "Error: nuke-sage not found relative to $(basename "$0")."
    echo "  Run it directly: scripts/nuke-sage todoscope"
    exit 1
  fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

command="$1"; shift
case "$command" in
  start)    cmd_start "$@" ;;
  stop)     cmd_stop ;;
  update)   cmd_update "$@" ;;
  dev)      cmd_dev "$@" ;;
  logs)     cmd_logs ;;
  open)     cmd_open ;;
  status)   cmd_status ;;
  tunnel)   cmd_tunnel ;;
  tailscale) cmd_tailscale ;;
  nuke)     cmd_nuke "$@" ;;
  version|-v|--version) cmd_version ;;
  -h|--help|help) usage ;;
  *) echo "Unknown command: $command"; usage; exit 1 ;;
esac
